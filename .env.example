# Backend service base URLs. Defaults match docker-compose dev.
VITE_AUTH_SERVICE_URL=http://localhost:8000       # sprints 01-02
VITE_ASR_SERVICE_URL=http://localhost:8001        # sprint 03
VITE_DICTATION_SERVICE_URL=http://localhost:8002  # sprint 04
VITE_CORE_SERVICE_URL=http://localhost:8003       # sprints 08-15 (clinical/EHR)
VITE_NLP_SERVICE_URL=http://localhost:8005        # sprint 05

# Keycloak (sprint 02 — used for "Forgot password" deep link)
VITE_AUTH_ISSUER=http://localhost:8088/realms/medical-dictation
VITE_AUTH_JWKS_URL=http://localhost:8088/realms/medical-dictation/protocol/openid-connect/certs
VITE_AUTH_AUDIENCE=mdx-api
VITE_AUTH_CLIENT_ID=mdx-frontend
VITE_KEYCLOAK_BASE_URL=http://localhost:8088

# Feature flags (drop with backend sprint deliveries).
VITE_FEAT_REPORTS=false        # sprint 08
VITE_FEAT_PATIENTS=false       # sprint 11
VITE_FEAT_NOTES=false          # sprint 12
VITE_FEAT_ANAMNESIS=false      # sprint 13
VITE_FEAT_TEMPLATES=false      # sprint 06
VITE_FEAT_MFA_ENROLMENT=false  # sprint 16
