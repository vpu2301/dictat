# Backend service base URLs. Defaults match docker-compose dev (integration
# guide §1). In production point every URL at the same same-origin gateway (§7)
# to avoid cross-origin CORS/cookie issues entirely.
VITE_AUTH_SERVICE_URL=http://localhost:8000          # auth/admin/audit
VITE_ASR_SERVICE_URL=http://localhost:8001           # batch transcription
VITE_DICTATION_SERVICE_URL=http://localhost:8002     # live streaming + WS
VITE_NLP_SERVICE_URL=http://localhost:8005           # post-processing pipeline
VITE_REPORT_SERVICE_URL=http://localhost:8006        # /v1/reports + /templates
VITE_AUTOCOMPLETE_SERVICE_URL=http://localhost:8007  # /autocomplete
VITE_SIGNING_SERVICE_URL=http://localhost:8008       # /signing + /verify (public)
VITE_CORE_SERVICE_URL=http://localhost:8003          # clinical/EHR core-service (doc 01)
VITE_NOTIFICATION_SERVICE_URL=http://localhost:8004  # notification feed + WS + preferences (sprint 12)
VITE_GENERATION_SERVICE_URL=http://localhost:8009    # Layer C inline completion (sprint 15)
VITE_MARKETING_SERVICE_URL=http://localhost:8012     # demo-booking emails — unauthenticated, public form only
# The Google appointment page the "Book a demo" buttons open, and the same URL
# marketing-service puts in its emails (MDX_DEMO_BOOKING_URL). Set both to the
# same calendar or a visitor gets two different ways to book.
VITE_DEMO_BOOKING_URL=https://calendar.app.google/336HQrX67TV9UNJr8
# Evidence (EVA-S03). Browser-facing only — evidence-ingest (:8010) is an
# operator service (CLI + service-token ops API bound to 127.0.0.1) and has no
# entry here or in services.js on purpose.
VITE_EVIDENCE_RETRIEVAL_URL=http://localhost:8011    # POST /retrieve
VITE_EVIDENCE_ANSWER_URL=http://localhost:8013       # answer API (S04)
VITE_EVIDENCE_WEBSEARCH_URL=http://localhost:8014    # web search connector (S08)

# Evidence chat (#/chat) answers from VITE_EVIDENCE_ANSWER_URL above — this
# platform's own evidence-answer, under the session's own Keycloak token. There
# is nothing to configure: point that URL at a running service and the chat is
# live; leave it unreachable and the module answers from its fixtures, and says
# so in the disclaimer under every answer.
#
# The three variables below are the OLD path: the separate EvidenzAI product
# whose answer API the chat borrowed before this platform had one. They do
# nothing unless VITE_EVIDENCE_CHAT_DIALECT=evidenzai is also set, and the code
# behind them is dev-only — Vite inlines env values into the bundle, so a
# password here is readable by anyone who opens the JS, and the whole credential
# path compiles out of a production build (src/api/evidenceChat.js).
VITE_EVIDENCE_CHAT_DIALECT=          # unset (this platform's service) | evidenzai
VITE_EVIDENCE_CHAT_URL=              # e.g. http://localhost:8020 (EvidenzAI api)
VITE_EVIDENCE_CHAT_EMAIL=            # dev service account on that backend
VITE_EVIDENCE_CHAT_PASSWORD=         # dev only — never set this in a deployed env
# VITE_CORE_URL is accepted as an alias for VITE_CORE_SERVICE_URL (S11 docs use it)
# In a same-origin gateway deployment, route these prefixes to core-service:
#   /patients  /encounters  /schedule  /notes  /note-structures  /scribe/*

# Keycloak (sprint 02 — used for "Forgot password" deep link)
VITE_AUTH_ISSUER=http://localhost:8088/realms/medical-dictation
VITE_AUTH_JWKS_URL=http://localhost:8088/realms/medical-dictation/protocol/openid-connect/certs
VITE_AUTH_AUDIENCE=mdx-api
VITE_AUTH_CLIENT_ID=mdx-frontend
VITE_KEYCLOAK_BASE_URL=http://localhost:8088

# Feature flags — canonical list. Each defaults false and flips to true in an
# environment ONLY after its backend dependency is deployed AND CORS-reachable
# there (doc 03 §1 rollout choreography). The comment names the gating backend.
VITE_FEAT_TEMPLATES=false      # report-service template create endpoint  (doc 02 §A4)
VITE_FEAT_REPORTS=false        # report-service /versions + /pdf          (doc 02 §A)
VITE_FEAT_PATIENTS=false       # core-service Phase 1: patients/encounters (doc 01 M2)
VITE_FEAT_NOTES=false          # core-service Phase 2: notes + scribe      (doc 01 M4/M5)
VITE_FEAT_ANAMNESIS=false      # core-service Phase 3: anamnesis + privacy (doc 01 M3/M6)
VITE_FEAT_MFA_ENROLMENT=false  # advertises TOTP enrolment in Profile → Security.
#   NOTE (sprint 16): this gates DISCOVERABILITY only. The #/mfa screen itself is
#   never flagged off — a user sent there by the backend's 403 `mfa_enrolment_required`
#   cannot work until they enrol, and a flagged-off page would strand them. Turn this
#   on once MDX_MFA_ENROLMENT_ENABLED is on server-side.
VITE_FEAT_NOTIFICATIONS=false  # notification-service :8004 (sprint 12)
VITE_FEAT_EVIDENCE_DEVTOOLS=false  # evidence retrieval devtools #/evidence/dev/* — DEV MACHINES ONLY (EVA-S03)
VITE_FEAT_EVIDENCE=false           # clinician evidence surface #/evidence — evidence-answer :8013 (EVA-S04)
VITE_FEAT_EVIDENCE_SUGGESTIONS=false      # GET /suggestions question bank (EVA-S04); needs VITE_FEAT_EVIDENCE
VITE_FEAT_EVIDENCE_EXTERNAL_LINKS=false   # allow outbound <a> to web sources; OFF ⇒ domain + cached-copy only

# Where /signup "Request access" leads are emailed. Leave blank to show the
# success state without composing a mail draft (doc 03 §4.1, option A).
VITE_ACCESS_REQUEST_EMAIL=

# ── Public signup form → HubSpot (src/api/leads.js) ──────────────────────
# The /signup lead form POSTs straight to HubSpot's Forms API. Both values are
# PUBLIC identifiers (the same pair HubSpot's own embed script puts in the
# page) — not secrets. Leave them blank and the form still works end to end,
# it just does not deliver: submitLead() reports `skipped` and the CSP does not
# widen for an origin nothing talks to.
#
# The portal must define three custom Contact properties, or HubSpot rejects
# the whole submission (see CUSTOM_PROPERTIES in src/api/leads.js):
#   medical_specialty · organisation_type · clinician_count
# The rest ride on built-ins: firstname, lastname, email, phone, company,
# city, country, jobtitle.
VITE_HUBSPOT_PORTAL_ID=
VITE_HUBSPOT_FORM_GUID=

# ── Content-Security-Policy (sprint 16) ──────────────────────────────────
#
# The policy is COMPUTED, not written down: src/security/csp.js derives it from
# the service URLs above, so a port that moves moves in the policy too. It is
# served by the vite dev and preview servers, and emitted at build time into
# dist/_headers (Netlify/Cloudflare Pages) and dist/security-headers.nginx.conf
# (`include` it from the server block serving dist/). Inspect the exact policy
# a build produced by reading those two files.
#
# ROLLOUT. The threat model asks for report-only first, then enforcement.
# `report-only` sends the identical policy as Content-Security-Policy-Report-Only:
# violations are reported and nothing is blocked. Run a week of a real clinic's
# traffic through it, read the reports, then flip to `enforce`.
#
#   enforce      (default) — the policy blocks. Ship this.
#   report-only            — measure without blocking. A rollout stage, not a
#                            shippable state: `npm run verify:bundle` fails a
#                            build whose emitted headers are report-only.
#   off                    — no CSP header at all. For proving, in a test, that
#                            a violation the policy would have blocked is real.
#
# A misspelt value falls back to `enforce` — this flag fails closed.
VITE_CSP_MODE=enforce
# Where browsers POST violation reports (the `report-uri` directive). Blank
# omits the directive entirely; an empty one is a parse error in some browsers.
VITE_CSP_REPORT_URI=
