# Local dev overrides — Sprint 11 patients/core-service is live.
# core-service runs on :8003 (see medical-dictation-backend docker-compose /
# `uvicorn core_service.main:app --port 8003`).
VITE_CORE_SERVICE_URL=http://localhost:8003

# Feature flags — flip on now that the gating backend (core-service) exists.
VITE_FEAT_PATIENTS=true   # patients roster + per-patient record + encounters
VITE_FEAT_NOTES=true      # clinical notes + note structures
VITE_FEAT_ANAMNESIS=true  # anamnesis + privacy (DSAR / erasure)
VITE_FEAT_REPORTS=true     # report-service /versions + /pdf (already deployed)
VITE_FEAT_TEMPLATES=true   # report-service template create (already deployed)

# Sprint 12 — notification-service :8004 (feed, WebSocket push, preferences).
# Gates the header bell, the toasts and /settings/notifications; with the flag
# off NotificationBell renders null and none of the UI is reachable.
VITE_NOTIFICATION_SERVICE_URL=http://localhost:8004
VITE_FEAT_NOTIFICATIONS=true

# EVA-S03 — evidence-retrieval :8011 (POST /retrieve).
#
# VITE_FEAT_EVIDENCE_DEVTOOLS is deliberately NOT set here. It is a build-time
# constant, and e2e/evidence-flag-off.spec.js asserts that every evidence path
# — including /evidence/dev/retrieval — falls through to the 404 while it is
# off. Turning it on in this file would make that spec fail, and its whole
# point is to catch a module that leaks a route.
#
# To open the playground in a dev browser, use the runtime override that exists
# for this (src/api/services.js devFlagOverride — dead code in a prod build),
# once per browser profile, in the console at localhost:5173:
#
#   localStorage.setItem("mdx.flag.evidenceDevtools", "1")   // then reload
#
# Then #/evidence/dev/retrieval, signed in as tenant_admin. Three things must
# also be true or the screen shows its unavailable/degraded state:
#   1. evidence-backend `make run-retrieval`   (sets the CORS allow-list for
#      5173 — without it the browser preflight is refused and nothing leaves
#      the tab; the service defaults to CORS-off because /retrieve is internal)
#   2. evidence-backend `make run-model-gateway`  (:8015, BGE-M3 — the dense
#      engine is mandatory, so a missing gateway means 0 passages + degraded)
#   3. platform dev-up + `make evidence-up`   (postgres, redis, opensearch)
VITE_EVIDENCE_RETRIEVAL_URL=http://localhost:8011

# EVA-S04 — evidence-answer :8013, THIS platform's own evidence surface
# (#/evidence, #/evidence/answers/:id, #/evidence/history). The URL below is
# also the built-in default in services.js, so it is here for visibility only.
#
# VITE_FEAT_EVIDENCE is deliberately NOT set here, for exactly the reason
# VITE_FEAT_EVIDENCE_DEVTOOLS is not: e2e/evidence-flag-off.spec.js asserts the
# clinician routes fall through to the 404 while the flag is off, and Playwright
# starts vite with this file loaded. Setting it here fails that spec.
#
# Use the same runtime override, once per browser profile, in the console:
#
#   localStorage.setItem("mdx.flag.evidence", "1")             // then reload
#   localStorage.setItem("mdx.flag.evidenceSuggestions", "1")  // question bank
#
# Then #/evidence, signed in as a role holding `evidence.ask` (clinician,
# nurse, tenant_admin — the list lives in the permission MATRIX, not here).
# evidence-backend must be serving :8013 with 5173 in its CORS allow-list.
VITE_EVIDENCE_ANSWER_URL=http://localhost:8013

# Evidence chat (#/chat) now answers from evidence-answer (:8013) above — OUR
# service, under the session's own Keycloak token. Nothing to configure here,
# and nothing to log into: if that container is up, the chat is live.
#
# It used to run on the separate EvidenzAI product at :8020 (its own repo, a
# service account of its own, its own Elasticsearch). That backend was a
# stopgap and it is gone; when it went, the chat went with it, which is the
# reason the default moved. To point at it again — restore the repo, bring its
# compose stack up, and set all four:
#
#   VITE_EVIDENCE_CHAT_DIALECT=evidenzai
#   VITE_EVIDENCE_CHAT_URL=http://localhost:8020
#   VITE_EVIDENCE_CHAT_EMAIL=dev@dictat.example.com
#   VITE_EVIDENCE_CHAT_PASSWORD=…            # dev builds only; never deployed
